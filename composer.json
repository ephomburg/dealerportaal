{
    "name": "homburg/dealerportaal",
    "description": "Ontwikkeltools voor het Homburg-dealerportaal (WordPress Coding Standards-controle).",
    "type": "project",
    "private": true,
    "require-dev": {
        "squizlabs/php_codesniffer": "^3.9",
        "wp-coding-standards/wpcs": "^3.1",
        "dealerdirect/phpcodesniffer-composer-installer": "^1.0"
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    },
    "scripts": {
        "lint": "phpcs"
    }
}
