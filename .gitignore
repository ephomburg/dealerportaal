# Volledige WordPress-kern, plugins van derden en uploads: geen eigen code,
# hoeft niet in de repo (WooCommerce zelf, WordPress-kernbestanden, media).
app/public/wp-admin/
app/public/wp-includes/
app/public/wp-content/uploads/
app/public/wp-content/plugins/woocommerce/
app/public/wp-content/themes/twentytwentyfive/
app/public/wp-content/themes/twentytwentyfour/
app/public/wp-content/themes/twentytwentythree/
app/public/*.php
app/public/.htaccess
app/public/license.txt
app/public/readme.html
app/public/wp-content/*.php
app/public/wp-content/index.php
app/public/wp-content/plugins/index.php
app/public/wp-content/themes/index.php
downloads/

# Geheimen en lokale Local-by-Flywheel-configuratie
app/public/wp-config.php
app/.envrc

# Server- en Local-omgevingsbestanden (niet projectcode)
conf/
logs/

# Tijdelijke testbestanden
*.tmp

# PHPCS/WordPress Coding Standards-tooling (composer.json/phpcs.xml.dist
# staan wel in de repo; composer.lock legt de exacte versies vast, vendor/
# zelf niet — dat installeert iedereen zelf via composer install).
/vendor/

# PHPUnit-testcache en de testdatabase-config (bevat lokale DB-credentials,
# net als wp-config.php) — tests/wp-tests-config-sample.php staat wel in
# de repo als sjabloon.
.phpunit.result.cache
tests/wp-tests-config.php
