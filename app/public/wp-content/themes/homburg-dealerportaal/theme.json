{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 2,
	"settings": {
		"appearanceTools": true,
		"layout": {
			"contentSize": "70%",
			"wideSize": "90%"
		},
		"color": {
			"palette": [
				{ "slug": "homburg-rood", "name": "Homburg rood", "color": "#c00d0d" },
				{ "slug": "homburg-rood-donker", "name": "Homburg rood (donker)", "color": "#9a0a0a" },
				{ "slug": "donkergrijs", "name": "Donkergrijs", "color": "#2b2d31" },
				{ "slug": "grijs-tekst", "name": "Grijs (tekst)", "color": "#55585e" },
				{ "slug": "grijs-licht", "name": "Grijs (licht)", "color": "#f4f5f7" },
				{ "slug": "wit", "name": "Wit", "color": "#ffffff" },
				{ "slug": "rand", "name": "Randkleur", "color": "#e2e4e8" }
			]
		},
		"typography": {
			"fontFamilies": [
				{
					"slug": "montserrat",
					"name": "Montserrat",
					"fontFamily": "'Montserrat', Arial, sans-serif"
				}
			],
			"fontSizes": [
				{ "slug": "small", "size": "0.9rem", "name": "Klein" },
				{ "slug": "medium", "size": "1rem", "name": "Normaal" },
				{ "slug": "large", "size": "1.5rem", "name": "Groot" },
				{ "slug": "x-large", "size": "2.2rem", "name": "Extra groot" }
			]
		}
	},
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--grijs-licht)",
			"text": "var(--wp--preset--color--donkergrijs)"
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--montserrat)",
			"lineHeight": "1.6"
		},
		"elements": {
			"link": {
				"color": {
					"text": "var(--wp--preset--color--homburg-rood)"
				},
				":hover": {
					"color": {
						"text": "var(--wp--preset--color--homburg-rood-donker)"
					}
				}
			},
			"button": {
				"color": {
					"background": "var(--wp--preset--color--homburg-rood)",
					"text": "var(--wp--preset--color--wit)"
				},
				":hover": {
					"color": {
						"background": "var(--wp--preset--color--homburg-rood-donker)"
					}
				}
			},
			"heading": {
				"color": {
					"text": "var(--wp--preset--color--donkergrijs)"
				}
			}
		}
	},
	"templateParts": [
		{ "name": "header", "area": "header" },
		{ "name": "footer", "area": "footer" }
	]
}
